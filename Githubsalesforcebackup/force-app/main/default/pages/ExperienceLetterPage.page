            <apex:image value="{!URLFOR($Resource.webSfdcStamp)}" style="height: 55px;"/>
            <p>
                (Director)
            </p>
            <p>
                Rakesh Kumar
            </p>
        </div>
        
        <div style="padding-top:30px">
            
            
            <hr/>
            <p style="padding: 0px 40px 0px 40px">  {!$Label.amrik__Office_address}, Zirakpur, Gazipur, Punjab ,Mobile : +91-70155 48507 Email : <a href="">info@websfdctech.co.in</a>, Web: <a href="">https://websfdc.in/</a></p>
        </div>
    </div>
