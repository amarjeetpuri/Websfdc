<apex:page extensions="ExperienceLetterController" standardController="Relieving_Letter__c" renderAs="pdf" lightningStylesheets="true" >
    <div class="post-description" style="padding: 0px 30px 0px 30px; displpay: inline-block">
        <apex:image value="{!URLFOR($Resource.webSfdcLogo)}" style="font-size: -5px;height: 56px;margin-left: 27px;margin-top: 19px;"/>
        <div style="margin-top: 50px">	
            
            <span>Dear {!reList.amrik__Candidate_Name__r.name},</span>
            <span style="float:right; font-weight: bold;">{!lastWorkingDay}</span>
            
        </div>
        
        <p><span style="font-weight: bold">Subject: </span>Experience Letter</p>
        
        <p style="padding-top: 20px">This is to certify that <strong>{!reList.amrik__Candidate_Name__r.name}</strong> was employed with us from <strong>{!joiningDate}</strong> to <strong>{!lastWorkingDay}.</strong><br/>
            {!genderStatus} designation at the time of leaving was <b> {!positionName}</b>. </p>
        
        <p style="padding-top: 20px">During {!genderStatus} tenure at <strong> Websfdc Technology </strong> {!heShe} has shown commendable skills in completing tasks that
            were assigned to {!genderStatus}. we have valued {!genderStatus} presence in our company and wish {!genderStatus} the very best for {!genderStatus}
            future endeavors.
        </p>
        
        <p style="padding-top: 20px">We wish you all the best in your future career.</p>
        
        
        <p style="padding-top: 20px">Yours Sincerely,</p>
        
        <p style="color:blue">Best Regards,</p>
        <p style="color:blue">Neha Sharma</p>
        <p style="color:grey">Manager – Human Resource</p>
        <apex:image value="{!URLFOR($Resource.webSfdcLogo)}" />
        <!--  <apex:image value="{!URLFOR($Resource.webSfdcStamp)}" style="height: 90px;margin-left: 200px;" /> --> 
