<apex:page standardController="Training_Program__c" renderAs="pdf" showHeader="false" sidebar="false" applyHtmlTag="false" applyBodyTag="false">
    <head>
        <style type="text/css">
            @page {
            size: A4 landscape;
            margin: 0mm;
            }
            body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
            color: #333;
            background-color: #F4C430;
            }
            .cert-container {
            margin: 15px;
            padding: 30px;
            position: relative;
            border: 8px solid #d12027;
            background-color: white;
            height: 510pt; 
            box-sizing: border-box;
            }
            
            .logo-top-left {
            position: absolute;
            top: 20px;
            left: 20px;
            }
            
            .header-title {
            font-size: 50pt;
            font-weight: bold;
            margin-top: 20px;
            color: #000;
            text-align: center;
            }
            
            .student-name {
            font-size: 40pt;
            font-family: 'serif'; 
            font-style: italic;
            color: #003366; 
            margin: 15px auto;
            border-bottom: 2px solid #003366;
            width: 70%;
            padding-bottom: 5px;
            text-align: center;
            }
            
            .content-body {
            font-size: 13.2pt; 
            line-height: 1.7;
            margin: 0px 70px 30px 70px; 
            text-align: justify;
            }
            
            .footer-table {
            width: 92%;
            margin: 0 auto;
            position: absolute;
            bottom: 40px;
            left: 4%;
            border-collapse: collapse;
            }
            
            .signature-box {
            text-align: center;
            width: 220px;
            float: right;
            }
            
            .signature-img {
            height: 75px;
            display: block;
            margin: 0 auto 5px auto;
            }
            
            .signature-line {
            border-top: 2px solid #003366;
            padding-top: 5px;
            font-weight: bold;
            font-size: 11pt;
            color: #000;
            }
        </style>
    </head>
    <body>
        <div class="cert-container">
            <div class="logo-top-left">
                <apex:image value="{!$Resource.WEBSFDCNewLogo}" width="180" />
            </div>
            
            <div class="header-title">CERTIFICATE</div>
            
            <div style="font-size: 18pt; font-weight: bold; color: #444; text-align: center; margin-top:5px;">
                Of <apex:outputText value=" {!HTMLENCODE(Training_Program__c.Technology__c)}"/> Training
            </div>
            
            <p style="margin-top: 20px; font-size: 14pt; font-style: italic; text-align: center;">This Certificate is Proudly Presented To</p>
            
            <div class="student-name"><apex:outputText value="{!HTMLENCODE(Training_Program__c.Name)}"/></div>
            
            <div class="content-body" style="margin-top: 50px;">
                This is to certify that <b><apex:outputText value="{!HTMLENCODE(Training_Program__c.Name)}"/></b> has successfully completed an intensive 
                professional training program in <b><apex:outputText value="{!HTMLENCODE(Training_Program__c.Technology__c)}"/></b> at <b>Websfdc Technology</b>. 
                The program was conducted from <b><apex:outputText value="{0, date, dd-MMM-yyyy}"><apex:param value="{!Training_Program__c.Start_Date__c}"/></apex:outputText></b> to 
                <b><apex:outputText value="{0, date, dd-MMM-yyyy}"><apex:param value="{!Training_Program__c.End_Date__c}"/></apex:outputText></b>.
                During this tenure, the trainee demonstrated outstanding proficiency in core architecture and automation.
            </div>
            
            <table class="footer-table">
                <tr>
                    <td style="text-align: left; vertical-align: bottom; width: 50%;">
                        <div style="width:220px; text-align:center;">
                            
                            <!-- Today's Date -->
                            <div style="font-size: 11pt; font-weight: bold; margin-bottom: 4px;">
                                <apex:outputText value="{0, date, dd-MMM-yyyy}">
                                    <apex:param value="{!Training_Program__c.Issued_Date__c}" />
                                </apex:outputText>
                            </div>
                            
                            <!-- Dotted Line -->
                            <div style="border-top: 2px dotted #003366; margin: 4px 0;"></div>
                            
                            <!-- Issued Date Label -->
                            <div style="font-size: 11pt; font-weight: bold;">
                                Issued Date
                            </div>
                            
                        </div>
                    </td>
                    
                    <td style="text-align: right; vertical-align: bottom; width: 50%;">
                        <div class="signature-box">
                            <apex:image value="{!$Resource.webSfdcStamp}" styleClass="signature-img"/>
                            <div class="signature-line">Director<br/>(Mrs. Manju)</div>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </body>
    
</apex:page>