            <p style="text-align: center">
                  {!$Label.amrik__Office_address}, Zirakpur, Gazipur, Punjab ,Mobile : +91-70155 48507 Email : <a href="">info@websfdctech.co.in</a>, Web: <a href="">https://websfdc.in/</a>
            </p>
        </div>
        
        
