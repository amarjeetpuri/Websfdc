<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Date_should_not_fall_in_weekend</fullName>
    <active>true</active>
    <errorConditionFormula>OR(MOD(Last_Working_Day__c - DATE( 1900, 1, 7 ), 7 ) == 0, MOD(Last_Working_Day__c - DATE( 1900, 1, 7 ), 7 ) == 6)</errorConditionFormula>
    <errorMessage>Date should not fall in weekend</errorMessage>
</ValidationRule>
