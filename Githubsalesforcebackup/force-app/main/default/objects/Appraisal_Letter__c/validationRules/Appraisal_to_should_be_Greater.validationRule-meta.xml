<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Appraisal_to_should_be_Greater</fullName>
    <active>true</active>
    <errorConditionFormula>Appraisal_From__c &gt; Appraisal_To__c</errorConditionFormula>
    <errorDisplayField>Appraisal_To__c</errorDisplayField>
    <errorMessage>Appraisal To should be Greater than Appraisal from</errorMessage>
</ValidationRule>
